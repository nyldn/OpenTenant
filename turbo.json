{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": [
    "tsconfig.base.json",
    "pnpm-workspace.yaml",
    "tooling/build/**",
    "tooling/migrations/sql/**"
  ],
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        "dist/**",
        "sql/**",
        ".next/**",
        "!.next/cache/**"
      ]
    },
    "lint": {
      "dependsOn": [
        "^build"
      ]
    },
    "typecheck": {
      "dependsOn": [
        "build"
      ]
    },
    "test": {
      "dependsOn": [
        "build"
      ]
    },
    "dev": {
      "dependsOn": [
        "^build"
      ],
      "cache": false,
      "persistent": true
    },
    "@opentenant/e2e#typecheck": {
      "dependsOn": [
        "@opentenant/platform#typecheck"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/tooling/uat/**"
      ]
    },
    "@opentenant/e2e#lint": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/tooling/uat/**"
      ]
    },
    "@opentenant/e2e#test": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/tooling/uat/**"
      ]
    }
  }
}
