{
  "name": "opentenant",
  "private": true,
  "license": "AGPL-3.0-only",
  "packageManager": "pnpm@11.13.1",
  "engines": {
    "node": ">=22.23.2 <23"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --filter=@opentenant/platform... --concurrency=32 --env-mode=loose",
    "local:setup": "docker compose up -d --wait --wait-timeout 60 postgres && pnpm --filter @opentenant/migrations local:migrate",
    "local:demo": "node tooling/uat/serve.mjs --demo",
    "local:migrate": "pnpm --filter @opentenant/migrations local:migrate",
    "unattended:status": "node tooling/unattended/src/cli.mjs status",
    "unattended:preflight": "node tooling/unattended/src/cli.mjs preflight",
    "unattended:prompt": "node tooling/unattended/src/cli.mjs prompt",
    "unattended:verify": "node tooling/unattended/src/cli.mjs verify",
    "unattended:run": "node tooling/unattended/src/cli.mjs run",
    "unattended:loop": "node tooling/unattended/src/cli.mjs loop",
    "unattended:propose": "node tooling/unattended/src/cli.mjs propose",
    "unattended:fog": "node tooling/unattended/src/cli.mjs fog",
    "unattended:graduate": "node tooling/unattended/src/cli.mjs graduate",
    "unattended:scaffold": "node tooling/unattended/src/cli.mjs scaffold",
    "unattended:review": "node tooling/unattended/src/cli.mjs review",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "check": "turbo run lint typecheck test",
    "quality:matrix": "node tooling/build/check-quality-order.mjs",
    "archify:doctor": "node scripts/archify-cli.mjs doctor",
    "archify:guide": "node scripts/archify-cli.mjs guide",
    "archify:validate": "node scripts/archify-cli.mjs validate",
    "archify:deliver": "node scripts/archify-cli.mjs deliver",
    "archify:update": "node scripts/update-archify.mjs",
    "archify:install-updater": "node scripts/install-archify-updater.mjs",
    "archify:remove-updater": "node scripts/install-archify-updater.mjs --remove",
    "ci:db-sequence": "node tooling/ci/db-sequence.mjs",
    "database:store-proof": "node tooling/ci/run-database-store-tests.mjs",
    "rls:proof": "node tooling/ci/rls-proof.mjs",
    "migrate:hosted": "pnpm --filter @opentenant/migrations migrate:hosted",
    "e2e": "pnpm --filter @opentenant/e2e e2e",
    "audit:verify": "pnpm --filter @opentenant/database audit:verify",
    "audit:anchor": "pnpm --filter @opentenant/database audit:anchor",
    "keys:rotate": "pnpm --filter @opentenant/database keys:rotate",
    "worker": "node --conditions=react-server --import ./tooling/provisioning/register.mjs apps/platform/workflows/worker.ts",
    "tenant:owner-invite": "node --conditions=react-server --import ./tooling/provisioning/register.mjs apps/platform/workflows/owner-invite-cli.ts",
    "tenant:seed-e2e": "node --experimental-strip-types tooling/provisioning/src/seed-worker-e2e.mjs",
    "docs:links": "pnpm --package=markdown-link-check@3.15.0 dlx -c 'node docs/adopters/check-links.mjs'",
    "restore:drill": "pnpm db:ephemeral -- node --conditions=react-server --import ./tooling/provisioning/register.mjs scripts/restore-drill.mjs",
    "db:ephemeral": "node tooling/db-ephemeral/cli.mjs",
    "unattended:failures": "node tooling/unattended/src/cli.mjs failures",
    "changeset": "changeset",
    "package:check": "node tooling/build/check-packages.mjs",
    "postinstall": "turbo run build --filter='./packages/*' --filter='./modules/*' --filter='./examples/*' --filter=@opentenant/migrations --filter=@opentenant/provisioning",
    "module:adopter-proof": "pnpm db:ephemeral -- node scripts/prove-packed-module.mjs",
    "module:audit": "node scripts/check-module-special-cases.mjs",
    "dx:timed": "node scripts/dx-timed.mjs",
    "release:local-proof": "pnpm db:ephemeral -- node scripts/release-local-proof.mjs",
    "sandbox:microvm-proof": "node tooling/proofs/microvm.mjs",
    "smtp:proof": "node tooling/proofs/smtp.mjs",
    "uat:serve": "node tooling/uat/serve.mjs",
    "uat:down": "node tooling/uat/down.mjs",
    "uat:start": "node tooling/uat/service.mjs start",
    "uat:status": "node tooling/uat/service.mjs status",
    "uat:reset": "node tooling/uat/reset.mjs",
    "uat:control": "node tooling/uat/control.mjs",
    "a11y:scan": "node tooling/e2e/audit/run.mjs"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@changesets/cli": "3.0.3",
    "@eslint/js": "^10.0.1",
    "@next/eslint-plugin-next": "15.5.29",
    "@types/node": "^22.10.0",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^16.5.0",
    "publint": "0.3.25",
    "tsdown": "0.23.7",
    "turbo": "^2.10.8",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.66.0",
    "vitest": "^3.0.0"
  }
}
