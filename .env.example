# Copy names into an ignored .env and supply installation-specific values.
# Local development: IDENTITY_PROVIDER=local, LOCAL_PUBLIC_ORIGIN=http://localhost:3000.
# Local identity is forbidden in production. WorkOS and Clerk require only their own settings.
IDENTITY_PROVIDER=
LOCAL_PUBLIC_ORIGIN=
LOCAL_TENANT_ID=
LOCAL_USER_ID=
LOCAL_USER_EMAIL=
LOCAL_USER_NAME=
LOCAL_PERMISSIONS=
PLATFORM_DEFAULT_TENANT_ID=
PLATFORM_PUBLIC_ORIGIN=
PLATFORM_ADMIN_HOST=
# Defaults to example.test outside production; required in production. Hostname only.
OPENTENANT_TENANT_BASE_DOMAIN=
PLATFORM_DEV_HOST_SUFFIXES=
# Required in production. Use the local loopback database for development.
CONTROL_PLANE_DATABASE_URL=

# Generate unique values before using remote modules or passcode access.
# Required in production, at least 32 characters each. Use separate dedicated secrets.
MODULE_ACCESS_SECRET=
CONNECTIONS_STATE_SECRET=
MODULE_SIGNING_PRIVATE_KEY=
MODULE_SIGNING_PUBLIC_KEY=

# Optional provider adapters. OpenTenant does not assume an account, team,
# project, organisation, or region. Keep real values only in ignored env files
# or a secret manager.
WORKOS_API_KEY=
WORKOS_CLIENT_ID=
WORKOS_COOKIE_PASSWORD=
WORKOS_REDIRECT_URI=
# Clerk CLI emits CLERK_PUBLISHABLE_KEY. NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY
# is also accepted for framework-specific secret-manager conventions.
CLERK_PUBLISHABLE_KEY=
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Exact Frontend API origin, allowed browser origins, and the audience added
# to Clerk's session-token claims. Comma-separate multiple exact values.
CLERK_JWT_ISSUER=
CLERK_AUTHORIZED_PARTIES=
CLERK_JWT_AUDIENCE=
# Required in production for tenant provisioning. Base64 AES-256 key decodes to 32 bytes.
# Legacy k0 key remains readable while a keyring is configured.
TENANT_DB_ENCRYPTION_KEY=
# Comma-separated id:base64 entries. Keep retired keys until rotation and state expiry.
TENANT_DB_ENCRYPTION_KEYS=
TENANT_DB_ENCRYPTION_ACTIVE_KEY_ID=
# Attributable operator for pnpm keys:rotate.
KEY_ROTATION_ACTOR_ID=
NEON_API_KEY=
NEON_ORG_ID=
VERCEL_API_KEY=
VERCEL_TEAM_ID=
VERCEL_PROJECT_ID=

# Optional model providers for the assessment example.
LLM_PROVIDER=
OPENAI_API_KEY=
OPENAI_MODEL=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
VERCEL_AI_GATEWAY_API_KEY=
GATEWAY_MODEL=

# Optional server-only module and OAuth integrations.
MODULE_REMOTE_HOST_ALLOWLIST=
LOCAL_SESSION_TOKEN=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
SLACK_OAUTH_CLIENT_ID=
SLACK_OAUTH_CLIENT_SECRET=

# Optional server observability. Leave empty to run without collectors or error capture.
# Full OTLP HTTP trace endpoint; URL credentials and query parameters are rejected.
OPENTENANT_OTLP_ENDPOINT=
# Any Sentry-protocol DSN, including a self-hosted endpoint. No client PII is sent.
SENTRY_DSN=
# Set only behind an ingress that strips/replaces this header and blocks direct access.
# Otherwise passcode/module mutations share a conservative unattributed IP budget.
OPENTENANT_TRUSTED_IP_HEADER=

# Production must choose a provisioning provider. Neon needs only NEON_*;
# Postgres needs an operator login with CREATE DATABASE/ROLE privileges.
PROVISIONING_PROVIDER=postgres
POSTGRES_ADMIN_DATABASE_URL=
POSTGRES_TENANT_REGION=operator
# Optional development-only identities; never set in production.
# LOCAL_USERS=[{"token":"synthetic-alpha","tenant":"tenant_alpha","user":"user_alpha","email":"alpha@example.test","name":"Alpha Owner","role":"tenant_owner"}]
# Optional Better Auth mail. No transport is created without the host.
IDENTITY_SMTP_HOST=
IDENTITY_SMTP_PORT=587
IDENTITY_SMTP_FROM=
IDENTITY_SMTP_USER=
IDENTITY_SMTP_PASSWORD=
